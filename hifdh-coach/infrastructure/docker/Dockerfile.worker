# ─── Hifdh Coach Celery Worker (CPU tasks) ─────────────────────────
# Multi-stage build for minimal production image

# Stage 1: Build
FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml .
RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: Production
FROM python:3.11-slim

RUN groupadd -r hifdh && useradd -r -g hifdh -d /app -s /sbin/nologin hifdh

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

WORKDIR /app
COPY backend/ .
RUN chown -R hifdh:hifdh /app
USER hifdh

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD celery -A app.tasks.celery_app:celery_app inspect ping --timeout 10 || exit 1

CMD ["celery", "-A", "app.tasks.celery_app:celery_app", \
     "worker", \
     "--loglevel=info", \
     "--queues=default", \
     "--concurrency=4", \
     "--max-tasks-per-child=100"]
