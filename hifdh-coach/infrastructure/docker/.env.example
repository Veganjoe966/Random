# ─── Hifdh Coach Environment Variables ──────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env to git.

# App
ENVIRONMENT=development
DEBUG=true

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hifdh
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hifdh_coach

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=generate-a-64-char-random-string-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_AUDIO=hifdh-audio

# Stripe (use test keys in dev)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Whisper AI
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Encryption
FIELD_ENCRYPTION_KEY=generate-a-32-byte-key-here!!!!!

# Sentry (optional)
SENTRY_DSN=

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
